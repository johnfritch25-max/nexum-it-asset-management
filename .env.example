# Nexum IT Asset Management System — Environment Configuration Template
# Copy this file to .env and fill in the values before running the application.
# NEVER commit .env to version control.

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY =

# Set to True for development, False for production
DEBUG = False

# Optional: Firebase push notification credentials
FIREBASE_APPLICATION_CREDENTIALS_FILE_DIRECTORY =

# SMTP email settings (optional — leave blank to use console email backend)
EMAIL_HOST =
EMAIL_HOST_USER =
EMAIL_HOST_PASSWORD =
EMAIL_PORT =

# Database settings
# For PostgreSQL: DB_ENGINE = django.db.backends.postgresql
# For MySQL:      DB_ENGINE = django.db.backends.mysql
DB_ENGINE =

DB_NAME =
DB_USERNAME =
DB_PASSWORD =
DB_HOST =
DB_PORT =

# Django ALLOWED_HOSTS (comma-separated, or * for development)
ALLOWED_HOSTS=

# CSRF trusted origins (comma-separated)
# Example: http://localhost,http://127.0.0.1,http://localhost:8080
CSRF_TRUSTED_ORIGINS=
